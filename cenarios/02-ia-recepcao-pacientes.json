     "type": "string",
     "description": "Nome do paciente. Preencha SEMPRE que o nome aparecer em qualquer ponto da conversa, no histórico ou na mensagem atual. Deixe vazio (\"\") apenas se o paciente nunca informou o nome."
    },
    "resposta": {
     "type": "string",
     "description": "A resposta em texto que a Bia envia ao paciente pelo WhatsApp"
    },
    "encaminhar_humano": {
     "type": "boolean",
     "description": "true se a conversa deve ser encaminhada para um setor humano, false caso contrário"
    },
    "destino": {
     "type": "string",
     "enum": [
      "financeiro",
      "agendamento",
      "clinico_dor",
      "clinico_protese",
      "atendimento_geral",
      "nenhum"
     ],
     "description": "Setor de destino quando encaminhar_humano é true. Use \"nenhum\" quando encaminhar_humano é false."
    }
   },
   "required": [
    "nome_cliente",
    "resposta",
    "encaminhar_humano",
    "destino"
   ],
   "additionalProperties": false
  }
